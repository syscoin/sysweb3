{
  "name": "@sidhujag/sysweb3-keyring",
  "version": "2.2.0",
  "description": "Keyring Manager for UTXO and Web3 Wallets",
  "main": "cjs/index.js",
  "types": "types/index.d.ts",
  "typesVersions": {
    "*": {
      "cjs/storage-core": [
        "types/storage-core.d.ts"
      ],
      "cjs/storage-core.js": [
        "types/storage-core.d.ts"
      ],
      "cjs/transactions/syscoin-core": [
        "types/transactions/syscoin-core.d.ts"
      ],
      "cjs/transactions/syscoin-core.js": [
        "types/transactions/syscoin-core.d.ts"
      ],
      "cjs/transactions/ethereum": [
        "types/transactions/ethereum.d.ts"
      ],
      "cjs/transactions/ethereum.js": [
        "types/transactions/ethereum.d.ts"
      ],
      "cjs/software": [
        "types/software.d.ts"
      ],
      "cjs/software.js": [
        "types/software.d.ts"
      ],
      "cjs/keyring-core": [
        "types/keyring-core.d.ts"
      ],
      "cjs/keyring-core.js": [
        "types/keyring-core.d.ts"
      ],
      "esm/ledger-host": [
        "types/ledger-host.d.ts"
      ],
      "esm/ledger-host.js": [
        "types/ledger-host.d.ts"
      ],
      "cjs/ledger/host-types": [
        "types/ledger/host-types.d.ts"
      ],
      "cjs/ledger/host-types.js": [
        "types/ledger/host-types.d.ts"
      ],
      "cjs/public-bip84": [
        "types/public-bip84.d.ts"
      ],
      "cjs/public-bip84.js": [
        "types/public-bip84.d.ts"
      ],
      "cjs/bip84-native": [
        "types/bip84-native.d.ts"
      ],
      "cjs/bip84-native.js": [
        "types/bip84-native.d.ts"
      ],
      "cjs/evm-fees": [
        "types/evm-fees.d.ts"
      ],
      "cjs/evm-fees.js": [
        "types/evm-fees.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syscoin/sysweb3.git"
  },
  "author": "Pali Wallet",
  "license": "MIT",
  "private": false,
  "engines": {
    "yarn": ">= 1.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist/",
    "build": "tsc && tsc -p tsconfig-ledger-host.json",
    "prerelease": "yarn build",
    "copy": "node ../../scripts/package/copy",
    "release:npm": "yarn publish ./dist --access=public --no-git-tag-version",
    "release:preflight": "npm pack ./dist --dry-run --json --ignore-scripts",
    "publishCode": "yarn prebuild && yarn prerelease && yarn copy && yarn release:npm",
    "type-check": "tsc --pretty --noEmit",
    "localTest": "yarn prebuild && yarn build && yarn copy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@ledgerhq/context-module": "2.8.0",
    "@ledgerhq/device-management-kit": "1.11.0",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.2",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@metamask/eth-sig-util": "^8.2.0",
    "@sidhujag/sysweb3-core": "^1.0.29",
    "@sidhujag/sysweb3-network": "^1.0.109",
    "@sidhujag/sysweb3-utils": "^1.1.280",
    "@trezor/connect-webextension": "10.0.1",
    "bip32": "^5.0.1",
    "bip32-path": "^0.4.2",
    "bitcoin-ops": "^1.4.1",
    "bitcoinjs-lib": "^7.0.5",
    "bs58check": "^3.0.1",
    "crypto-js": "^4.1.1",
    "ethers": "^6.17.0",
    "rxjs": "7.8.2",
    "varuint-bitcoin": "^2.0.0"
  },
  "peerDependencies": {
    "syscoinjs-lib": "^1.0.276"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.10",
    "dotenv": "^16.0.3",
    "rimraf": "^6.0.1",
    "syscoinjs-lib": "^1.0.276",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "wif": "^5.0.0"
  },
  "resolutions": {
    "axios": "^1.18.1",
    "jws": "^4.0.1"
  }
}
